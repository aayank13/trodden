{
  "description": "Recall a learned procedure on each prompt and when a command fails with an error a past session fixed; learn from the session when a turn or session ends.",
  "hooks": {
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "trodden hook claude-code", "timeout": 5 }] }
    ],
    "PostToolUseFailure": [
      { "matcher": "Bash", "hooks": [{ "type": "command", "command": "trodden hook claude-code", "timeout": 5 }] }
    ],
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "trodden hook claude-code", "timeout": 5 }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "trodden hook claude-code", "timeout": 5 }] }
    ],
    "PreCompact": [
      { "hooks": [{ "type": "command", "command": "trodden hook claude-code", "timeout": 5 }] }
    ],
    "SessionEnd": [
      { "hooks": [{ "type": "command", "command": "trodden hook claude-code", "timeout": 5 }] }
    ]
  }
}
